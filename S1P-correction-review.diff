index 0000000..ee1ca83
--- /dev/null
+++ b/tests/sendgrid/inverse-sweep.test.ts
@@ -0,0 +1,143 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+import { describe, expect, it } from 'vitest';
+
+import type { ProviderEvidenceRecord } from '../../src/audit/provider/protocol/readWire.js';
+import { runInverseSweep } from '../../validation/sendgrid/harness/inverseSweep.js';
+import { toProviderReadResult } from '../../validation/sendgrid/audit/activityRecords.js';
+
+/**
+ * `§15` — `I8`'s INVERSE SWEEP: THE MACHINERY, AND THE LIMIT ON WHAT IT PROVES.
+ *
+ * =================================================================================
+ * THE TWO THINGS THIS FILE ASSERTS, AND THE ONE IT REFUSES TO
+ *
+ * ASSERTED: the sweep reads the provider PERIOD-BOUNDED and NOT tag-bounded, so it can find a
+ * record ACOS never sent; and a failed read concludes nothing.
+ *
+ * NOT ASSERTED, ANYWHERE: that `I8` has been evaluated. `§15`: "No live evidence means the
+ * empirical leg remains open." Nothing in this repository has run this against a real account,
+ * and `docs/implementation/S1P-result.md` records `I8` as UNCHANGED.
+ * =================================================================================
+ */
+
+const ACCOUNTED = 'acos-corr-00000000-0000-4000-8000-000000000001';
+const STRANGER = 'acos-corr-00000000-0000-4000-8000-000000000002';
+
+function record(tag: string | null, id: string): ProviderEvidenceRecord {
+  return {
+    providerMessageId: id,
+    providerStatus: 'delivered',
+    providerTimestampMs: 0,
+    correlationTag: tag,
+  };
+}
+
+function reader(records: readonly ProviderEvidenceRecord[]) {
+  const seen: (string | null)[] = [];
+  return {
+    seen,
+    read: (query: { readonly correlationTag: string | null }) => {
+      seen.push(query.correlationTag);
+      return Promise.resolve({
+        kind: 'EVIDENCE' as const,
+        records,
+        recordCount: records.length,
+      });
+    },
+  };
+}
+
+const PERIOD = { periodStartMs: 0, periodEndMs: 1_000, maxRecords: 100 };
+
+describe('`§15` — THE SWEEP IS PERIOD-BOUNDED AND **NOT** TAG-BOUNDED', () => {
+  it('it reads with `correlationTag: null`, which is what makes I8 answerable at all', async () => {
+    const provider = reader([record(ACCOUNTED, 'm1')]);
+    await runInverseSweep(provider, {
+      ...PERIOD,
+      accountedCorrelationTags: new Set([ACCOUNTED]),
+    });
+    /*
+     * THE DEFECT `§15` NAMES, RULED OUT DIRECTLY.
+     *
+     * A tag-narrowed read can only return records carrying a tag ACOS supplied, so it can
+     * never find the record `I8` exists to find. The query this sweep issues carries no tag.
+     */
+    expect(provider.seen).toEqual([null]);
+  });
+
+  it('a record carrying an UNACCOUNTED tag is reported', async () => {
+    const result = await runInverseSweep(reader([record(ACCOUNTED, 'm1'), record(STRANGER, 'm2')]), {
+      ...PERIOD,
+      accountedCorrelationTags: new Set([ACCOUNTED]),
+    });
+    expect(result.outcome).toBe('UNACCOUNTED_PROVIDER_RECORDS');
+    expect(result.unaccounted.map((entry) => entry.providerMessageId)).toEqual(['m2']);
+    expect(result.statement).toContain('a second uncontrolled actor');
+  });
+
+  it('a record carrying NO tag at all is ALSO unaccounted', async () => {
+    /*
+     * The most important of the three cases, and the one a tag-narrowed read cannot see.
+     *
+     * A message ACOS sent carries the tag the adapter put on `categories`. An UNTAGGED message
+     * in this account's window is therefore a message ACOS did not send — which is precisely
+     * `I8`'s "no external effect exists in any vendor system that ACOS did not journal".
+     */
+    const result = await runInverseSweep(reader([record(null, 'stranger')]), {
+      ...PERIOD,
+      accountedCorrelationTags: new Set([ACCOUNTED]),
+    });
+    expect(result.outcome).toBe('UNACCOUNTED_PROVIDER_RECORDS');
+    expect(result.unaccounted[0]?.correlationTag).toBeNull();
+  });
+
+  it('a clean sweep says so, and says what it is bounded by', async () => {
+    const result = await runInverseSweep(reader([record(ACCOUNTED, 'm1')]), {
+      ...PERIOD,
+      accountedCorrelationTags: new Set([ACCOUNTED]),
+    });
+    expect(result.outcome).toBe('ALL_PROVIDER_RECORDS_ACCOUNTED');
+    expect(result.providerRecordsInPeriod).toBe(1);
+    expect(result.statement).toContain('bounded by the record limit');
+  });
+});
+
+describe('`§15`, `§9` — SILENCE IS NOT AGREEMENT', () => {
+  it('a REFUSED provider read yields SWEEP_UNAVAILABLE, never a clean sweep', async () => {
+    /*
+     * Driven through the REAL correction-9 mapping, so the discrimination is the one the audit
+     * plane would actually make: a 403 becomes `PROVIDER_UNAVAILABLE`, and this sweep refuses
+     * to read that as "the provider holds nothing unaccounted for".
+     */
+    const result = await runInverseSweep(
+      {
+        read: () =>
+          Promise.resolve(
+            toProviderReadResult(
+              { kind: 'REFUSED_BY_PROVIDER', httpStatus: 403 },
+              'MESSAGE_ACTIVITY_SEARCH',
+            ),
+          ),
+      },
+      { ...PERIOD, accountedCorrelationTags: new Set([ACCOUNTED]) },
+    );
+    expect(result.outcome).toBe('SWEEP_UNAVAILABLE');
+    expect(result.providerRecordsInPeriod).toBeNull();
+    expect(result.unaccounted).toEqual([]);
+    expect(result.statement).toContain('SILENCE IS NOT AGREEMENT');
+  });
+});
+
+describe('`§15` — THE MODULE IS MACHINERY, AND SAYS SO', () => {
+  it('it holds no `fetch`, no credential and no client — it reads through the audit IPC', () => {
+    const source = readFileSync(join('validation', 'sendgrid', 'harness', 'inverseSweep.ts'), 'utf8');
+    expect(source).not.toContain('fetch(');
+    expect(source).not.toContain('secret');
+    expect(source).not.toContain('providerReadClient');
+    // AND IT QUOTES THE AUTHORITATIVE DEFINITION rather than paraphrasing a completion report.
+    expect(source).toContain('No external effect exists in any vendor system that ACOS did not');
+    expect(source).toContain('THIS IS MACHINERY, NOT EVIDENCE');
+  });
+});
diff --git a/tests/sendgrid/observation.test.ts b/tests/sendgrid/observation.test.ts
