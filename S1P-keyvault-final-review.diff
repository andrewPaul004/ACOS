+  const failures: Stage1Gate[] = [];
+  if (facts.sandboxModeRequested) failures.push('SANDBOX_MODE_ENABLED');
+  if (facts.recipientReachableFromProductionState) failures.push('PRODUCTION_TARGET_REACHABLE');
