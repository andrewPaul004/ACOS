+  'ACTION_CLASS_NOT_IN_VERIFIED_CATALOGUE',
+  /** The verified catalogue routes the class somewhere other than the SendGrid adapter. */
+  'ACTION_CLASS_NOT_ROUTED_TO_ADAPTER',
+  /**
