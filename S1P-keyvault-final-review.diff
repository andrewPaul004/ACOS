+      [{ auditSignedRecordProvider: 'synthetic_esp' }, 'AUDIT_CLASS_5_RECORD_SCOPE_MISMATCH'],
+      [{ integrationRiskClass: 'MONEY_MOVING' }, 'INTEGRATION_CREDENTIAL_NOT_OPTION_A_LEGAL'],
