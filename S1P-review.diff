+    periodStartMs: PERIOD_START,
+    periodEndMs: PERIOD_END,
+    maxAttempts: 4,
+    intervalMs: MIN_OBSERVATION_INTERVAL_MS,
+    maxDurationMs: 5 * 60 * 1000,
+    maxRecords: 50,
+    ...overrides,
