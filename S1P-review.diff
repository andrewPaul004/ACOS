+    return { kind: 'REFUSED', reason: 'CORRELATION_TAG_MALFORMED' };
+  }
+  if (!isUsableAddress(input.senderAddress)) {
+    return { kind: 'REFUSED', reason: 'ADDRESS_MALFORMED' };
+  }
+  if (!isUsableAddress(input.sinkAddress)) {
+    return { kind: 'REFUSED', reason: 'ADDRESS_MALFORMED' };
+  }
