+  CORRELATION_CUSTOM_ARG,
+  OWNER_SINK_MARKER,
+  SEND_MAPPING_REFUSALS,
+  VALIDATION_SUBJECT_PREFIX,
+  buildSendGridSendRequest,
+  isOwnerControlledSink,
+} from '../../validation/sendgrid/integration/requestMapping.js';
+
+/**
+ * `§8.1`, `§8.3`, `§8.6` — THE DETERMINISTIC MAPPING, AND THE SANDBOX REFUSAL.
+ *
+ * `§8.6`: "For S1P real validation, sandbox mode true must fail before the send. Add a
+ * DISCRIMINATING test for this. **Do not merely document it.**"
+ *
+ * The discrimination is the pair: the same input with `sandboxMode: false` produces a request
+ * whose `mail_settings.sandbox_mode.enable` is `false`, and with `sandboxMode: true` produces
+ * a REFUSAL rather than a request with the flag set. A test that only asserted the emitted
+ * `false` would pass against an implementation that ignored the input entirely.
+ */
+
+const SINK = `owner+${OWNER_SINK_MARKER}@example.test`;
+const SENDER = 'validation@nonprod.example.test';
+
+function validInput(tag: string) {
+  return { correlationTag: tag, senderAddress: SENDER, sinkAddress: SINK, sandboxMode: false };
+}
+
+describe('`§8.6` — SANDBOX MODE FAILS BEFORE THE PROVIDER BOUNDARY', () => {
+  it('sandboxMode true is REFUSED, and no request is produced at all', () => {
+    const tag = mintCorrelationTag();
+    const result = buildSendGridSendRequest({ ...validInput(tag), sandboxMode: true });
+    expect(result.kind).toBe('REFUSED');
+    if (result.kind === 'REFUSED') expect(result.reason).toBe('SANDBOX_MODE_REFUSED');
+  });
+
+  it('and the SAME input with sandboxMode false produces a request whose flag is false', () => {
+    /*
+     * THE DISCRIMINATING HALF. Without it, an implementation that never read `sandboxMode`
+     * would pass the refusal test by refusing nothing and the emission test by emitting a
+     * constant — so the two cases are asserted on ONE input that differs in one field.
+     */
+    const tag = mintCorrelationTag();
+    const result = buildSendGridSendRequest(validInput(tag));
+    expect(result.kind).toBe('REQUEST');
+    if (result.kind !== 'REQUEST') return;
+    expect(result.body.mail_settings.sandbox_mode.enable).toBe(false);
+  });
