+function verify(
+  rawHeaders: readonly string[],
+  rawBody: Buffer = BODY,
+  key: ParsedVerificationKey = KEY_A,
+): string {
+  const outcome = verifySendGridEventWebhookV1({ rawHeaders, rawBody, verificationKey: key });
+  return outcome.verified ? 'VERIFIED' : outcome.refusal;
