{
  "name": "acos-control-plane",
  "version": "0.0.0-s1a",
  "private": true,
  "description": "ACOS control plane — S1A exposure-ledger substrate proof. Non-production architectural MVP.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:reset": "tsx src/db/migrate.ts reset",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:negative-controls": "vitest run tests/negative-controls",
    "spike": "vitest run spikes/durable-execution",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.11.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@dbos-inc/node-pg-datasource": "4.27.6",
    "@types/node": "20.19.9",
    "@types/pg": "8.15.5",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "eslint": "9.32.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
